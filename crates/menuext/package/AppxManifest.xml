<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse package for "Turn on Deskboxes" in Windows 11's desktop context menu (crates/menuext).
  Unsigned (the publisher's OID marks it so; no certificate). Windows 11 registers an unsigned
  package that declares an application only from an administrator (per user it fails with
  0x80073D2B), so the installer asks once. Its files live in the install folder (the external
  location).
  The installer registers it; uninstall removes it. The version is not the app's: updates replace
  the DLL in place, and only a change to this manifest needs a new version (and admin again).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">
  <Identity Name="Deskboxes.DesktopMenu" ProcessorArchitecture="x64"
    Publisher="CN=Deskboxes, OID.2.25.311729368913984317654407730594956997722=1" Version="1.0.0.0" />
  <Properties>
    <DisplayName>Deskboxes</DisplayName>
    <PublisherDisplayName>Deskboxes</PublisherDisplayName>
    <Logo>menu-logo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26300.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
  <Applications>
    <Application Id="Deskboxes" Executable="deskboxes-watchdog.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements DisplayName="Deskboxes" Description="Deskboxes" BackgroundColor="transparent"
        Square150x150Logo="menu-logo.png" Square44x44Logo="menu-logo.png" AppListEntry="none" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="DeskboxesTurnOn" Clsid="E635630E-E581-4382-B31F-5CE245560EBD" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Deskboxes menu">
              <com:Class Id="E635630E-E581-4382-B31F-5CE245560EBD" Path="deskboxes_menu.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
