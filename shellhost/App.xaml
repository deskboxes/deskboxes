<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="DeskboxesShellHost.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <!-- WinUI's default style caps a CommandBarFlyout's list at 480 px and scrolls; menus with
           Deskboxes' own entries are taller. MenuView lifts it again when the menu opens. -->
      <Style TargetType="CommandBarOverflowPresenter">
        <Setter Property="MaxHeight" Value="1600" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
